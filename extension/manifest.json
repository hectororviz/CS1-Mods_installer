{
  "manifest_version": 3,
  "name": "CS1 Mods Installer",
  "version": "1.0.0",
  "description": "Instala mods de smods.ru en Cities: Skylines con un clic, usando tu backend local CS1 Mods Installer.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://smods.ru/archives/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
